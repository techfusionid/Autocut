# Required by Docker Compose. Replace this placeholder with a private random token.
# The local terminal runner disables authentication for loopback-only testing.
API_TOKEN=replace-this-with-a-private-random-token

# Defaults: data, 15728640 bytes (15 MiB), 25000000 pixels, 60 seconds, 3 attempts.
DATA_DIR=data
MAX_UPLOAD_BYTES=15728640
MAX_IMAGE_PIXELS=25000000
JOB_TIMEOUT_SECONDS=60
MAX_JOB_ATTEMPTS=3
